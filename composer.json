{
	"name": "toastnz/blocks",
	"description": "Silverstripe content blocks module",
	"type": "silverstripe-vendormodule",
	"keywords": [
		"silverstripe",
		"content blocks",
		"modular"
	],
	"license": "BSD-3-Clause",
	"authors": [
		{
			"name": "Jaydn de Graaf",
			"homepage": "http://pinc.nz/",
			"role": "Developer"
		},
		{
			"name": "Danae Miller-Clendon",
			"homepage": "http://toast.co.nz/",
			"role": "Developer"
		},
		{
			"name": "Emmanuel Davies",
			"homepage": "http://toast.co.nz/",
			"role": "Developer"
		}
	],
	"require": {
		"silverstripe/cms": "^6.2",
		"silverstripe/framework": "^6.2",
		"composer/installers": "*",
		"symbiote/silverstripe-gridfieldextensions": "^5.1",
		"toastnz/linkable": "dev-ss6",
		"undefinedoffset/sortablegridfield": "^3.0",
		"axllent/silverstripe-form-fields": "^2.0.1",
		"silverstripe/userforms": "^7.1.1",
		"unclecheese/silverstripe-image-optionset": "dev-master"
	},
	"extra": {
		"expose": [
			"images"
		]
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"silverstripe/vendor-plugin": true
		}
	}
}
